[Unit]
Description=Render GitHub contribution heatmap to PNG
Documentation=https://github.com/Numbatt/github-heatmap-wallpaper/blob/main/contrib/linux/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Override these via: systemctl --user edit gh-wallpaper.service
# GH_USER is intentionally empty so a forgotten override fails fast and
# loud rather than silently rendering someone else's heatmap.
Environment=GH_USER=
Environment=GH_THEME=github-dark
Environment=GH_CANVAS=2560x1440
Environment=GH_OUTPUT=%h/.cache/gh-wallpaper/wallpaper.png
ExecStart=%h/.local/bin/gh-wallpaper render --user ${GH_USER} --theme ${GH_THEME} --canvas ${GH_CANVAS} --output ${GH_OUTPUT}
# To set the wallpaper after each render, append a drop-in pointing at one
# of the contrib/linux/examples/set-wallpaper-*.sh shims for your DE:
#   systemctl --user edit gh-wallpaper.service
#     [Service]
#     ExecStartPost=%h/.local/bin/set-wallpaper-gnome.sh

[Install]
WantedBy=default.target
